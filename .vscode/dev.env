# MINI-CRM — variáveis do depurador e da descoberta de testes no HOST.
#
# ATENÇÃO: valores SÓ de desenvolvimento, coerentes com o docker-compose.yml
# (banco publicado em 127.0.0.1:3434). Este arquivo é versionado — nunca
# coloque aqui credencial real. Produção usa .env (ver .env.example).
APP_ENV=development
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql+psycopg://minicrm:minicrm@localhost:3434/minicrm
TEST_DATABASE_URL=postgresql+psycopg://minicrm:minicrm@localhost:3434/minicrm_test
JWT_SECRET=dev-jwt-secret-trocar-em-producao-0123456789
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3100
DEFAULT_TIMEZONE=America/Sao_Paulo
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@minicrm.local
AI_ENABLED=false
